{
  "name": "Linux KDE Lite",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8080, 6080, 3000],
  "portsAttributes": {
    "8080": {
      "label": "KDE Desktop (noVNC)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "6080": {
      "label": "KDE Desktop Alternate (noVNC)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3000": {
      "label": "Antigravity Web Hub",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "5901": {
      "label": "TigerVNC (Internal)",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postStartCommand": "/usr/local/bin/start-desktop.sh",
  "postAttachCommand": "nohup /usr/local/bin/ensure-ports-public.sh >/tmp/ensure-ports-public.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "google.google-antigravity"
      ],
      "settings": {
        "security.workspace.trust.enabled": false,
        "security.workspace.trust.startupPrompt": "never",
        "antigravity.serverPort": 3000,
        "remote.otherPortsAttributes": {
          "onAutoForward": "ignore"
        },
        "remote.portsAttributes": {
          "5901": {
            "onAutoForward": "ignore"
          }
        }
      }
    }
  }
}
