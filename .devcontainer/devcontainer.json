{
  "name": "Linux KDE Lite",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8080, 6080],
  "portsAttributes": {
    "8080": {
      "label": "KDE Desktop (noVNC)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "6080": {
      "label": "KDE Desktop Alternate (noVNC)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postStartCommand": "/usr/local/bin/start-desktop.sh"
}
